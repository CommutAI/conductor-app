{
  "appId": "com.omanfortsco.conductor",
  "appName": "Conductor App",
  "webDir": "build",
  "icon": "public/assets/conductor.png",
  "splash": {
    "backgroundColor": "#1a1f3c",
    "image": "public/assets/conductor.png",
    "androidScaleType": "CENTER",
    "androidSplashFullScreen": true,
    "androidSplashImmersive": true,
    "splashShowDuration": 2000,
    "showSpinner": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#1a1f3c",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#1a1f3c"
    },
    "Camera": {
      "permissions": ["camera"]
    },
    "Geolocation": {
      "permissions": ["location"]
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK",
      "resizeOnFullScreen": true
    }
  }
}
